  schCreateNoteLabel(cv 0:4.6 "reset TGs RS1 (vfb-ninv), RS2 (nnon-vref): rst/rstb" "lowerLeft" "R0" "stick" 0.15 "normalLabel")
  i = A_inst(cv "gpdk180" "nmos" "RS1N" 0:4 "R0" nil) A_mos(i 0.8 "180n" 1 1) A_conn(cv i list(list("D" "vfb") list("G" "rst") list("S" "ninv") list("B" "vss")))
  i = A_inst(cv "gpdk180" "pmos" "RS1P" 1.6:4 "R0" nil) A_mos(i 0.8 "180n" 1 1) A_conn(cv i list(list("D" "vfb") list("G" "rstb") list("S" "ninv") list("B" "vdd")))
