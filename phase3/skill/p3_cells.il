; Phase-2 helpers (needs sim/afe/afe_util.il loaded: A_w A_set A_inst A_mos A_pin A_stub)
; connect every terminal of instance i with a stub + net label.
; MOS (gpdk nmos/pmos, nmos_u5/pmos_u2): fixed directions (D/S vertical, G left, B right).
; other symbols: stub leaves through the nearest edge of the master's pin bBox.
procedure(A_conn(cv i conns)
  let((cn isn bb x0 y0 x1 y1 p px py dl dr dd du dir m pins)
    cn = i~>master~>cellName
    isn = member(cn '("nmos" "nmos_u5"))
    if(member(cn '("nmos" "pmos" "nmos_u5" "pmos_u2")) then
      foreach(c conns
        dir = case(car(c) ("G" "l") ("B" "r") ("D" if(isn "u" "d")) ("S" if(isn "d" "u")))
        A_stub(cv i car(c) cadr(c) dir if(car(c) == "B" 0.375 0.25)))
    else
      pins = foreach(mapcar tm i~>master~>terminals A_pin(i tm~>name))
      x0 = apply('min mapcar('xCoord pins)) x1 = apply('max mapcar('xCoord pins))
      y0 = apply('min mapcar('yCoord pins)) y1 = apply('max mapcar('yCoord pins))
      foreach(c conns
        p = A_pin(i car(c)) px = xCoord(p) py = yCoord(p)
        dl = px - x0 dr = x1 - px dd = py - y0 du = y1 - py
        m = min(dl dr dd du)
        dir = cond(((x1 - x0) < 0.01 if(du <= dd "u" "d"))
                   ((y1 - y0) < 0.01 if(dl <= dr "l" "r"))
                   ((m == dl) "l") ((m == dr) "r") ((m == du) "u") (t "d"))
        A_stub(cv i car(c) cadr(c) dir 0.25)))))

; Phase-3 helper: gpdk mos with width given as an expression/design variable (single finger, multiplier m)
procedure(A_mosv(i W L m)
  A_set(i "fingers" "1") A_set(i "fw" W) A_set(i "w" W) A_set(i "l" L) A_set(i "m" sprintf(nil "%d" m))
  A_set(i "ad" strcat(W "*0.6u")) A_set(i "as" strcat(W "*0.6u"))
  A_set(i "pd" strcat("2*" W "+1.2u")) A_set(i "ps" strcat("2*" W "+1.2u")))

procedure(P3_bias_gen_v2()
 let((cv i)
  cv = dbOpenCellViewByType("AFE_lib" "bias_gen_v2" "schematic" "schematic" "w")
  schCreatePin(cv dbOpenCellViewByType("basic" "iopin" "symbol") "vdd" "inputOutput" nil -3.5:1 "R0")
  A_w(cv list(-3.5:1 -3.0:1)) schCreateWireLabel(cv nil -3.0:1 "vdd" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "iopin" "symbol") "vss" "inputOutput" nil -3.5:0.5 "R0")
  A_w(cv list(-3.5:0.5 -3.0:0.5)) schCreateWireLabel(cv nil -3.0:0.5 "vss" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "iref" "input" nil -3.5:0 "R0")
  A_w(cv list(-3.5:0 -3.0:0)) schCreateWireLabel(cv nil -3.0:0 "iref" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "opin" "symbol") "nbp" "output" nil -3.5:-0.5 "R0")
  A_w(cv list(-3.5:-0.5 -3.0:-0.5)) schCreateWireLabel(cv nil -3.0:-0.5 "nbp" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "opin" "symbol") "vcp" "output" nil -3.5:-1 "R0")
  A_w(cv list(-3.5:-1 -3.0:-1)) schCreateWireLabel(cv nil -3.0:-1 "vcp" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "opin" "symbol") "vcn" "output" nil -3.5:-1.5 "R0")
  A_w(cv list(-3.5:-1.5 -3.0:-1.5)) schCreateWireLabel(cv nil -3.0:-1.5 "vcn" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "opin" "symbol") "vcm1" "output" nil -3.5:-2 "R0")
  A_w(cv list(-3.5:-2 -3.0:-2)) schCreateWireLabel(cv nil -3.0:-2 "vcm1" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreateNoteLabel(cv 0:1.2 "bias_gen_v2: IREF->MBN (nbn = iref); MBS/MCP/MBP -> vcp, nbp; separate VCN branch MPV1-8 (~3 nA) -> MCN1/MCN2" "lowerLeft" "R0" "stick" 0.15 "normalLabel")
  i = A_inst(cv "AFE_lib" "nmos_u5" "MBN" 0:0 "R0" nil)  A_conn(cv i list(list("D" "iref") list("G" "iref") list("S" "vss") list("B" "vss")))
  i = A_inst(cv "AFE_lib" "nmos_u5" "MBS" 2.5:0 "R0" nil)  A_conn(cv i list(list("D" "vcp") list("G" "iref") list("S" "vss") list("B" "vss")))
  i = A_inst(cv "gpdk180" "pmos" "MCP" 5:0 "R0" nil) A_mos(i 20.0 "1u" 1 1) A_conn(cv i list(list("D" "vcp") list("G" "vcp") list("S" "nbp") list("B" "nbp")))
  i = A_inst(cv "AFE_lib" "pmos_u2" "MBP" 7.5:0 "R0" nil)  A_conn(cv i list(list("D" "nbp") list("G" "nbp") list("S" "vdd") list("B" "vdd")))
  i = A_inst(cv "gpdk180" "nmos" "MCN1" 10:0 "R0" nil) A_mos(i 0.4 "10u" 1 1) A_conn(cv i list(list("D" "vcn") list("G" "vcn") list("S" "vcm1") list("B" "vss")))
  i = A_inst(cv "gpdk180" "nmos" "MCN2" 12.5:0 "R0" nil) A_mos(i 0.4 "10u" 1 1) A_conn(cv i list(list("D" "vcm1") list("G" "vcm1") list("S" "vss") list("B" "vss")))
  i = A_inst(cv "AFE_lib" "pmos_u2" "MPV1" 0:-2.5 "R0" nil)  A_conn(cv i list(list("D" "mpv1") list("G" "nbp") list("S" "vdd") list("B" "vdd")))
  i = A_inst(cv "AFE_lib" "pmos_u2" "MPV2" 2.5:-2.5 "R0" nil)  A_conn(cv i list(list("D" "mpv2") list("G" "nbp") list("S" "mpv1") list("B" "vdd")))
  i = A_inst(cv "AFE_lib" "pmos_u2" "MPV3" 5:-2.5 "R0" nil)  A_conn(cv i list(list("D" "mpv3") list("G" "nbp") list("S" "mpv2") list("B" "vdd")))
  i = A_inst(cv "AFE_lib" "pmos_u2" "MPV4" 7.5:-2.5 "R0" nil)  A_conn(cv i list(list("D" "mpv4") list("G" "nbp") list("S" "mpv3") list("B" "vdd")))
  i = A_inst(cv "AFE_lib" "pmos_u2" "MPV5" 10:-2.5 "R0" nil)  A_conn(cv i list(list("D" "mpv5") list("G" "nbp") list("S" "mpv4") list("B" "vdd")))
  i = A_inst(cv "AFE_lib" "pmos_u2" "MPV6" 12.5:-2.5 "R0" nil)  A_conn(cv i list(list("D" "mpv6") list("G" "nbp") list("S" "mpv5") list("B" "vdd")))
  i = A_inst(cv "AFE_lib" "pmos_u2" "MPV7" 15:-2.5 "R0" nil)  A_conn(cv i list(list("D" "mpv7") list("G" "nbp") list("S" "mpv6") list("B" "vdd")))
  i = A_inst(cv "AFE_lib" "pmos_u2" "MPV8" 17.5:-2.5 "R0" nil)  A_conn(cv i list(list("D" "vcn") list("G" "nbp") list("S" "mpv7") list("B" "vdd")))
  schCheck(cv) dbSave(cv)
  when(ddGetObj("AFE_lib" "bias_gen_v2" "symbol") ddDeleteObj(ddGetObj("AFE_lib" "bias_gen_v2" "symbol")))
  schPinListToSymbol("AFE_lib" "bias_gen_v2" "symbol" schSchemToPinList("AFE_lib" "bias_gen_v2" "schematic"))
  list(cv~>modifiedButNotSaved length(cv~>instances))))

procedure(P3_ota_fc_lna_v2()
 let((cv i)
  cv = dbOpenCellViewByType("AFE_lib" "ota_fc_lna_v2" "schematic" "schematic" "w")
  schCreatePin(cv dbOpenCellViewByType("basic" "iopin" "symbol") "vdd" "inputOutput" nil -3.5:1 "R0")
  A_w(cv list(-3.5:1 -3.0:1)) schCreateWireLabel(cv nil -3.0:1 "vdd" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "iopin" "symbol") "vss" "inputOutput" nil -3.5:0.5 "R0")
  A_w(cv list(-3.5:0.5 -3.0:0.5)) schCreateWireLabel(cv nil -3.0:0.5 "vss" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "vip" "input" nil -3.5:0 "R0")
  A_w(cv list(-3.5:0 -3.0:0)) schCreateWireLabel(cv nil -3.0:0 "vip" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "vin" "input" nil -3.5:-0.5 "R0")
  A_w(cv list(-3.5:-0.5 -3.0:-0.5)) schCreateWireLabel(cv nil -3.0:-0.5 "vin" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "iref" "input" nil -3.5:-1 "R0")
  A_w(cv list(-3.5:-1 -3.0:-1)) schCreateWireLabel(cv nil -3.0:-1 "iref" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "opin" "symbol") "vout" "output" nil -3.5:-1.5 "R0")
  A_w(cv list(-3.5:-1.5 -3.0:-1.5)) schCreateWireLabel(cv nil -3.0:-1.5 "vout" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreateNoteLabel(cv 0:1.2 "ota_fc_lna_v2: Phase-2 OTA + bias_gen_v2 (VCN lowered -> folding nodes ~0.30 V), M7/M8 2u/20u" "lowerLeft" "R0" "stick" 0.15 "normalLabel")
  i = A_inst(cv "AFE_lib" "pmos_u2" "M0<0:15>" 0:0 "R0" nil)  A_conn(cv i list(list("D" "tail") list("G" "nbp") list("S" "vdd") list("B" "vdd")))
  i = A_inst(cv "gpdk180" "pmos" "M1" 2.5:0 "R0" nil) A_mos(i 50.0 "LIN" 1 10) A_conn(cv i list(list("D" "f1") list("G" "vip") list("S" "tail") list("B" "tail")))
  i = A_inst(cv "gpdk180" "pmos" "M2" 5:0 "R0" nil) A_mos(i 50.0 "LIN" 1 10) A_conn(cv i list(list("D" "f2") list("G" "vin") list("S" "tail") list("B" "tail")))
  i = A_inst(cv "AFE_lib" "nmos_u5" "M3<0:9>" 0:-2.5 "R0" nil)  A_conn(cv i list(list("D" "f1") list("G" "iref") list("S" "vss") list("B" "vss")))
  i = A_inst(cv "AFE_lib" "nmos_u5" "M4<0:9>" 2.5:-2.5 "R0" nil)  A_conn(cv i list(list("D" "f2") list("G" "iref") list("S" "vss") list("B" "vss")))
  i = A_inst(cv "gpdk180" "nmos" "M5" 5:-2.5 "R0" nil) A_mos(i 0.4 "1u" 1 1) A_conn(cv i list(list("D" "x1") list("G" "vcn") list("S" "f1") list("B" "vss")))
  i = A_inst(cv "gpdk180" "nmos" "M6" 7.5:-2.5 "R0" nil) A_mos(i 0.4 "1u" 1 1) A_conn(cv i list(list("D" "vout") list("G" "vcn") list("S" "f2") list("B" "vss")))
  i = A_inst(cv "gpdk180" "pmos" "M7" 0:-5 "R0" nil) A_mos(i 2.0 "20u" 1 1) A_conn(cv i list(list("D" "p1") list("G" "x1") list("S" "vdd") list("B" "vdd")))
  i = A_inst(cv "gpdk180" "pmos" "M8" 2.5:-5 "R0" nil) A_mos(i 2.0 "20u" 1 1) A_conn(cv i list(list("D" "p2") list("G" "x1") list("S" "vdd") list("B" "vdd")))
  i = A_inst(cv "gpdk180" "pmos" "M9" 5:-5 "R0" nil) A_mos(i 0.6 "1u" 1 1) A_conn(cv i list(list("D" "x1") list("G" "vcp") list("S" "p1") list("B" "vdd")))
  i = A_inst(cv "gpdk180" "pmos" "M10" 7.5:-5 "R0" nil) A_mos(i 0.6 "1u" 1 1) A_conn(cv i list(list("D" "vout") list("G" "vcp") list("S" "p2") list("B" "vdd")))
  i = A_inst(cv "AFE_lib" "bias_gen_v2" "XB" 0:-8 "R0" nil)  A_conn(cv i list(list("vdd" "vdd") list("vss" "vss") list("iref" "iref") list("nbp" "nbp") list("vcp" "vcp") list("vcn" "vcn") list("vcm1" "vcm1")))
  schCheck(cv) dbSave(cv)
  when(ddGetObj("AFE_lib" "ota_fc_lna_v2" "symbol") ddDeleteObj(ddGetObj("AFE_lib" "ota_fc_lna_v2" "symbol")))
  schPinListToSymbol("AFE_lib" "ota_fc_lna_v2" "symbol" schSchemToPinList("AFE_lib" "ota_fc_lna_v2" "schematic"))
  list(cv~>modifiedButNotSaved length(cv~>instances))))

procedure(P3_ota_fc_chop()
 let((cv i)
  cv = dbOpenCellViewByType("AFE_lib" "ota_fc_chop" "schematic" "schematic" "w")
  schCreatePin(cv dbOpenCellViewByType("basic" "iopin" "symbol") "vdd" "inputOutput" nil -3.5:1 "R0")
  A_w(cv list(-3.5:1 -3.0:1)) schCreateWireLabel(cv nil -3.0:1 "vdd" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "iopin" "symbol") "vss" "inputOutput" nil -3.5:0.5 "R0")
  A_w(cv list(-3.5:0.5 -3.0:0.5)) schCreateWireLabel(cv nil -3.0:0.5 "vss" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "vip" "input" nil -3.5:0 "R0")
  A_w(cv list(-3.5:0 -3.0:0)) schCreateWireLabel(cv nil -3.0:0 "vip" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "vin" "input" nil -3.5:-0.5 "R0")
  A_w(cv list(-3.5:-0.5 -3.0:-0.5)) schCreateWireLabel(cv nil -3.0:-0.5 "vin" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "iref" "input" nil -3.5:-1 "R0")
  A_w(cv list(-3.5:-1 -3.0:-1)) schCreateWireLabel(cv nil -3.0:-1 "iref" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "opin" "symbol") "vout" "output" nil -3.5:-1.5 "R0")
  A_w(cv list(-3.5:-1.5 -3.0:-1.5)) schCreateWireLabel(cv nil -3.0:-1.5 "vout" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "c1" "input" nil -3.5:-2 "R0")
  A_w(cv list(-3.5:-2 -3.0:-2)) schCreateWireLabel(cv nil -3.0:-2 "c1" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "c1b" "input" nil -3.5:-2.5 "R0")
  A_w(cv list(-3.5:-2.5 -3.0:-2.5)) schCreateWireLabel(cv nil -3.0:-2.5 "c1b" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "c2" "input" nil -3.5:-3 "R0")
  A_w(cv list(-3.5:-3 -3.0:-3)) schCreateWireLabel(cv nil -3.0:-3 "c2" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "c2b" "input" nil -3.5:-3.5 "R0")
  A_w(cv list(-3.5:-3.5 -3.0:-3.5)) schCreateWireLabel(cv nil -3.0:-3.5 "c2b" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "o1" "input" nil -3.5:-4 "R0")
  A_w(cv list(-3.5:-4 -3.0:-4)) schCreateWireLabel(cv nil -3.0:-4 "o1" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "o1b" "input" nil -3.5:-4.5 "R0")
  A_w(cv list(-3.5:-4.5 -3.0:-4.5)) schCreateWireLabel(cv nil -3.0:-4.5 "o1b" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "o2" "input" nil -3.5:-5 "R0")
  A_w(cv list(-3.5:-5 -3.0:-5)) schCreateWireLabel(cv nil -3.0:-5 "o2" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "o2b" "input" nil -3.5:-5.5 "R0")
  A_w(cv list(-3.5:-5.5 -3.0:-5.5)) schCreateWireLabel(cv nil -3.0:-5.5 "o2b" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "o3" "input" nil -3.5:-6 "R0")
  A_w(cv list(-3.5:-6 -3.0:-6)) schCreateWireLabel(cv nil -3.0:-6 "o3" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "o3b" "input" nil -3.5:-6.5 "R0")
  A_w(cv list(-3.5:-6.5 -3.0:-6.5)) schCreateWireLabel(cv nil -3.0:-6.5 "o3b" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "o4" "input" nil -3.5:-7 "R0")
  A_w(cv list(-3.5:-7 -3.0:-7)) schCreateWireLabel(cv nil -3.0:-7 "o4" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreatePin(cv dbOpenCellViewByType("basic" "ipin" "symbol") "o4b" "input" nil -3.5:-7.5 "R0")
  A_w(cv list(-3.5:-7.5 -3.0:-7.5)) schCreateWireLabel(cv nil -3.0:-7.5 "o4b" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCreateNoteLabel(cv 0:1.2 "ota_fc_chop: folded cascode, input-pair PMOS cascodes MC1/MC2 (gate vcm1), M5/M6 0.4u/4u" "lowerLeft" "R0" "stick" 0.15 "normalLabel")
  schCreateNoteLabel(cv 0:-10.6 "CH1 input chopper vip/vin -> g1/g2 (M1/M2 gates): CMOS TGs 0.8u/0.18u + half-size dummies, NON-overlapping c1/c2" "lowerLeft" "R0" "stick" 0.15 "normalLabel")
  schCreateNoteLabel(cv 0:-13.6 "CH2 demodulator f1/f2 -> s5/s6 (M5/M6 sources): CMOS TGs, OVERLAPPING o1/o2 (make-before-break)" "lowerLeft" "R0" "stick" 0.15 "normalLabel")
  schCreateNoteLabel(cv 0:-16.6 "CH3 load-mirror chopper p1/p2 -> q9/q10 (M9/M10 sources): CMOS TGs, overlapping o3/o4" "lowerLeft" "R0" "stick" 0.15 "normalLabel")
  i = A_inst(cv "AFE_lib" "pmos_u2" "M0<0:15>" 0:0 "R0" nil)  A_conn(cv i list(list("D" "tail") list("G" "nbp") list("S" "vdd") list("B" "vdd")))
  i = A_inst(cv "gpdk180" "pmos" "M1" 2.5:0 "R0" nil) A_mosv(i "WINF" "LIN" 10) A_conn(cv i list(list("D" "d1") list("G" "g1") list("S" "tail") list("B" "tail")))
  i = A_inst(cv "gpdk180" "pmos" "M2" 5:0 "R0" nil) A_mosv(i "WINF" "LIN" 10) A_conn(cv i list(list("D" "d2") list("G" "g2") list("S" "tail") list("B" "tail")))
  i = A_inst(cv "gpdk180" "pmos" "MC1" 7.5:0 "R0" nil) A_mos(i 50.0 "1u" 1 4) A_conn(cv i list(list("D" "f1") list("G" "vcm1") list("S" "d1") list("B" "d1")))
  i = A_inst(cv "gpdk180" "pmos" "MC2" 10:0 "R0" nil) A_mos(i 50.0 "1u" 1 4) A_conn(cv i list(list("D" "f2") list("G" "vcm1") list("S" "d2") list("B" "d2")))
  i = A_inst(cv "AFE_lib" "nmos_u5" "M3<0:9>" 0:-2.5 "R0" nil)  A_conn(cv i list(list("D" "f1") list("G" "iref") list("S" "vss") list("B" "vss")))
  i = A_inst(cv "AFE_lib" "nmos_u5" "M4<0:9>" 2.5:-2.5 "R0" nil)  A_conn(cv i list(list("D" "f2") list("G" "iref") list("S" "vss") list("B" "vss")))
  i = A_inst(cv "gpdk180" "nmos" "M5" 5:-2.5 "R0" nil) A_mos(i 0.4 "4u" 1 1) A_conn(cv i list(list("D" "x1") list("G" "vcn") list("S" "s5") list("B" "vss")))
  i = A_inst(cv "gpdk180" "nmos" "M6" 7.5:-2.5 "R0" nil) A_mos(i 0.4 "4u" 1 1) A_conn(cv i list(list("D" "vout") list("G" "vcn") list("S" "s6") list("B" "vss")))
