  i = A_inst(cv "analogLib" "vdc" "VA" -2:0 "R0" nil) dbReplaceProp(i "vdc" "string" "0.9+DV") dbDeletePropByName(i "acm") A_conn(cv i list(list("PLUS" "a") list("MINUS" "gnd!")))
  i = A_inst(cv "analogLib" "vdc" "VB" 3:0 "R0" nil) dbReplaceProp(i "vdc" "string" "0.9") dbDeletePropByName(i "acm") A_conn(cv i list(list("PLUS" "b") list("MINUS" "gnd!")))
  A_inst(cv "analogLib" "gnd" "GND0" 0:-2 "R0" nil) A_w(cv list(0:-2 0:-1.75)) schCreateWireLabel(cv nil 0:-1.75 "gnd!" "lowerLeft" "R0" "stick" 0.0625 nil)
  schCheck(cv) dbSave(cv)
  when(ddGetObj("AFE_lib" "tb_pseudo_r" "symbol") ddDeleteObj(ddGetObj("AFE_lib" "tb_pseudo_r" "symbol")))
  schPinListToSymbol("AFE_lib" "tb_pseudo_r" "symbol" schSchemToPinList("AFE_lib" "tb_pseudo_r" "schematic"))
  list(cv~>modifiedButNotSaved length(cv~>instances))))

procedure(P2_tb_lna()
 let((cv i y)
  cv = dbOpenCellViewByType("AFE_lib" "tb_lna" "schematic" "schematic" "w")
  A_inst(cv "analogLib" "gnd" "GND0" -3:-5 "R0" nil) A_w(cv list(-3:-5 -3:-4.75)) schCreateWireLabel(cv nil -3:-4.75 "gnd!" "lowerLeft" "R0" "stick" 0.0625 nil)
  i = A_inst(cv "analogLib" "vdc" "VREF" -3:0 "R0" nil) dbReplaceProp(i "vdc" "string" "VREF") dbDeletePropByName(i "acm") A_conn(cv i list(list("PLUS" "vref") list("MINUS" "gnd!")))
  i = A_inst(cv "AFE_lib" "lna_cci" "I1" 0:0 "R0" nil)  A_conn(cv i list(list("vinp" "vinp1") list("vinn" "vinn1") list("vref" "vref") list("vout" "vout1") list("vdd" "vdd1") list("vss" "gnd!") list("iref" "iref1")))
  i = A_inst(cv "analogLib" "vdc" "VDD1" 3:2 "R0" nil) dbReplaceProp(i "vdc" "string" "VDD") dbDeletePropByName(i "acm") A_conn(cv i list(list("PLUS" "vdd1") list("MINUS" "gnd!")))
  i = A_inst(cv "analogLib" "idc" "IREF1" 4:2 "R0" nil) dbReplaceProp(i "idc" "string" "IREF") A_conn(cv i list(list("PLUS" "vdd1") list("MINUS" "iref1")))
  i = A_inst(cv "analogLib" "cap" "CL1" 3:-2 "R0" nil) dbReplaceProp(i "c" "string" "CL") A_conn(cv i list(list("PLUS" "vout1") list("MINUS" "gnd!")))
  i = A_inst(cv "analogLib" "vsin" "VIP1" -1.5:-2 "R0" nil) dbReplaceProp(i "vdc" "string" "VCM+VOS") dbReplaceProp(i "vo" "string" "VCM+VOS") dbReplaceProp(i "va" "string" "AMP/2") dbReplaceProp(i "freq" "string" "FSIG") dbReplaceProp(i "sinephase" "string" "0") dbReplaceProp(i "acm" "string" "0.5") A_conn(cv i list(list("PLUS" "vinp1") list("MINUS" "gnd!")))
  i = A_inst(cv "analogLib" "vsin" "VIN1" -0.5:-2 "R0" nil) dbReplaceProp(i "vdc" "string" "VCM") dbReplaceProp(i "vo" "string" "VCM") dbReplaceProp(i "va" "string" "AMP/2") dbReplaceProp(i "freq" "string" "FSIG") dbReplaceProp(i "sinephase" "string" "180") dbReplaceProp(i "acm" "string" "0.5") dbReplaceProp(i "acp" "string" "180") A_conn(cv i list(list("PLUS" "vinn1") list("MINUS" "gnd!")))
  i = A_inst(cv "AFE_lib" "lna_cci" "I2" 8:0 "R0" nil)  A_conn(cv i list(list("vinp" "vinp2") list("vinn" "vinn2") list("vref" "vref") list("vout" "vout2") list("vdd" "vdd2") list("vss" "gnd!") list("iref" "iref2")))
